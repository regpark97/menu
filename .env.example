# Modelo de variaveis de ambiente do SipFlow.
# Copie este arquivo para ".env" e preencha com os valores do SEU projeto Supabase.
# O ".env" esta no .gitignore e NUNCA deve ser comitado.
#
# Onde encontrar: painel do Supabase > Settings > API Keys

# URL publica do projeto (https://SEU-PROJECT-ID.supabase.co)
SUPABASE_URL=""
# Chave publicavel (sb_publishable_...). Segura para expor no navegador.
SUPABASE_PUBLISHABLE_KEY=""
# ID do projeto (12 caracteres)
SUPABASE_PROJECT_ID=""

# As mesmas tres variaveis com prefixo VITE_ sao injetadas no bundle do navegador.
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_PROJECT_ID=""

# ATENCAO: a Secret key (sb_secret_...) NAO entra aqui.
# Ela ignora as regras de seguranca (RLS) e nunca deve chegar ao navegador.
# Use-a apenas em servidor, se algum dia for necessario.

# ---------------------------------------------------------------------------
# Deploy na Vercel (Settings > Environment Variables do projeto)
# Cadastre EXATAMENTE estas 6 variaveis (Production + Preview + Development):
#   SUPABASE_URL                 (obrigatoria)
#   SUPABASE_PUBLISHABLE_KEY     (obrigatoria)
#   SUPABASE_PROJECT_ID          (opcional, so metadata)
#   VITE_SUPABASE_URL            (obrigatoria - vai no bundle do navegador)
#   VITE_SUPABASE_PUBLISHABLE_KEY (obrigatoria - vai no bundle do navegador)
#   VITE_SUPABASE_PROJECT_ID     (opcional)
# O NITRO_PRESET=vercel ja esta fixado no vercel.json, nao precisa cadastrar.
# ---------------------------------------------------------------------------
